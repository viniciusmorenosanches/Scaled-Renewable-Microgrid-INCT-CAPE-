% stairs(time,dat.Pot_cc, 'LineWidth', 2.0)
% legend('u_{el}', 'u_{fc}', 'FontSize', 12)
% ylabel('Electrol./\newlineFuel cell', 'FontSize', 14)
% xlabel('Time (h)', 'FontSize', 12)
