% --- Script Avançado com Controle por Teclado em Tempo Real ---

% Limpeza inicial
clear; clc; close all; clearvars;

microgrid_init_w_demand

data = load("dados_cenario_24h_reformulado.mat");

% if ~isempty(instrfind)
%      fclose(instrfind);
%      delete(instrfind);
% end

k1 = 3.92e-5 * 400;
k2 = 4.08e-5 * 400;
%k3 = 130e-9;
k3 = 0.1 * Ts; % mm/s
%k4 = 82.63e-9;
k4 = 0.0658 * Ts; % mm/s

time_to_turn_on = 100;

% --- Inicialização do controlador PI SoC---
SoC_ref = 0.6;   % referência desejada
ref_h2 = 5;
Kp = 150;         % ganho proporcional
Ki = 10;          % ganho integrador
Ts = 0.1;        % tempo de amostragem aproximado em s
integrador = 0;  % inicializa integrador
Pc_max = 400;    % potência máxima de carga (ajuste conforme seu sistema)
Pd_max = 400;    % potência máxima de descarga (ajuste conforme seu sistema)


kcc = 154.57;
kel = 10; % talvez seja 100
uel = 0;
ucc = 0;

% --- 1. Configuração da Comunicação Serial ---
port = "COM9"; % !!! MUDE AQUI para a sua porta COM !!!
baudRate = 9600;
s = serialport(port, baudRate);
configureTerminator(s, "LF"); % Define o terminador de linha
disp("Conectado ao Arduino na porta " + port);

% --- 2. Preparação da Figura e Subplots ---
fig = figure('Name','Monitoramento Microrrede','NumberTitle','off');
tiledlayout(fig,3,1)  % 3 linhas, 1 coluna

% Subplot 1: Nível da água
ax1 = nexttile;
h1 = animatedline(ax1,'Color','b');
ax1.YGrid = 'on';
title(ax1,'Nível de H2');
xlabel(ax1,'Tempo (s)');
ylabel(ax1,'Nível (mm)');

% Subplot 2: Potências
ax2 = nexttile;
h2_cc     = animatedline(ax2,'Color','r','LineWidth',1.5,'DisplayName','Pot\_cc');
h2_el     = animatedline(ax2,'Color','c','LineWidth',1.5,'DisplayName','Pot\_el');
h2_total  = animatedline(ax2,'Color','k','LineWidth',1.5,'DisplayName','Pot\_total');
h2_wt     = animatedline(ax2,'Color','g','LineWidth',1.5,'DisplayName','Pot\_wt');
h2_pv     = animatedline(ax2,'Color','m','LineWidth',1.5,'DisplayName','Pot\_pv');
h2_c     = animatedline(ax2,'Color','b','LineWidth',1.5,'DisplayName','Pot\_carga');
h2_d     = animatedline(ax2,'Color','y','LineWidth',1.5,'DisplayName','Pot\_descarga');
h2_demand = animatedline(ax2,'Color','cyan','LineWidth',1.0,'DisplayName','demand');
ax2.YGrid = 'on';
legend(ax2,'show');
title(ax2,'Potências');
xlabel(ax2,'Tempo (s)');
ylabel(ax2,'Potência (W)');

% Subplot 3: Estado de Carga (SoC) com mostrador de bateria
ax3 = nexttile;
%batteryBar = bar(ax3,0,0.5,'FaceColor','g'); % barra inicial
ylim(ax3,[0 1]);
xlim(ax3,[-0.5 0.5]);
ax3.XTick = [];
ax3.YTick = [];
title(ax3,'Estado de Carga da Bateria');
% Desenha contorno da bateria
hold(ax3,'on');
rectangle(ax3,'Position',[-0.4 0 0.8 1],'EdgeColor','k','LineWidth',2); % corpo
rectangle(ax3,'Position',[-0.1 1 0.2 0.1],'FaceColor','k'); % terminal
socBar = rectangle(ax3,'Position',[-0.4 0 0 1],'FaceColor','white'); % preenchimento inicial
hold(ax3,'off');


% --- 3. Loop de Leitura e Plotagem ---
disp("Iniciando a leitura... ");
startTime = datetime('now');
i = 0;
lastSendTime = 0;  % inicializa

nivelAgua(1) = 5;
SoC(1) = 0.5;
uel = 0;
ucc = 0;
Pot_carga = 0;
Pot_descarga = 0;

demand(1) = 0;


while ishandle(fig) % Continua enquanto a figura estiver aberta
    try
        i = i + 1;
        
        % --------------------------------------------------
        % 1. MATLAB MANDA AS ORDENS E REFERÊNCIAS PRIMEIRO
        % --------------------------------------------------
        % Puxa o clima da tua base de dados (exemplo usando teu data.mat)
        % Se não tiveres no .mat, podes fixar um valor temporário como 150 e 80
        if i <= length(data.demanda) 
            ref_sol = 150; % Substitui por data.ref_sol(i) se existir
            ref_vento = 80; % Substitui por data.ref_vento(i) se existir
        else
            ref_sol = 0; ref_vento = 0;
        end
        
        % Agora o sprintf tem 6 valores (Pc, Pd, ucc, uel, ref_sol, ref_vento)
        linha_envio = sprintf('%.2f,%.2f,%d,%d,%.2f,%.2f', Pot_carga, Pot_descarga, ucc, uel, ref_sol, ref_vento);
        writeline(s, linha_envio);
        
        % --------------------------------------------------
        % 2. MATLAB LÊ A RESPOSTA (O Arduino responde imediatamente)
        % -------------------------------------------------- 
        valores = split(data_str, ',');  % cell array de strings
        valores_num = str2double(valores);  % array de doubles

        nivelAgua(i) = valores_num(1);
        %nivelAgua(i + 1) = 1*nivelAgua(i) + k3*uel - k4*ucc;

        %Pot_cc(i)    = valores_num(2);
        Pot_cc(i) = kcc*ucc;

        Pot_el(i) = kel*uel;
        %Pot_el(i) = 1;
        
        %SoC(i)       = valores_num(4); 
        if i > time_to_turn_on
            SoC(i) = 0.995*SoC(i - 1) + k1/400*Pot_carga - k2/400*Pot_descarga;
        else
            SoC(i) = 1;
        end
        
        %SoC(i + 1) = 0.995*SoC(i) + k1/400*Pot_carga - k2/400*Pot_descarga;
        Pot_wt(i)    = valores_num(5);%*50;
        Pot_pv(i)    = valores_num(6);%*1.5;


        %demand(i) = 0.8*Pot_wt(end) + 0.8*Pot_pv(end);
        % if i > 500 && i <= 1000
        %     demand(i) = data.demanda(i)*2.5;
        % elseif i > 1000 && i <= 1500
        %     demand(i) = data.demanda(i)*2.7;
        % elseif i > 1500 && i < 2100
        %     demand(i) =  data.demanda(i)*1.8;
        % else
        %     demand(i) = data.demanda(i)*2;
        % end

        demand(i) = data.demanda(i);

      fprintf('Iteração: %d | Pot_pv: %.2f W | Pot_wt: %.2f W | SoC: %.2f | Nível H2: %.2f\n', ...
                 i, Pot_pv(i), Pot_wt(i), SoC(i), nivelAgua(i));
        % -------------------------------
        

        Pot_total(i) = Pot_wt(i) + Pot_pv(i) + Pot_cc(i) - Pot_el(i) - Pot_carga + Pot_descarga;

        % % --- Envio a cada 1 segundo ---
        % t_now = seconds(datetime('now') - startTime);
        % if t_now - lastSendTime >= 1
        %     lastSendTime = t_now;
        %     linha = sprintf('%.1f,%.1f,%.1f,%.1f', Pot_carga, Pot_descarga, ucc, uel);
        %     writeline(s, linha);
        % end

        % Atualiza gráficos
        t = seconds(datetime('now') - startTime);

        % Nível da água
        addpoints(h1, t, nivelAgua(i));
        ax1.XLim = [max(0, t - 50), t + 5];

        % Potências
        addpoints(h2_cc, t, Pot_cc(i));
        addpoints(h2_el, t, Pot_el(i));
        addpoints(h2_total, t, Pot_total(i));
        addpoints(h2_wt, t, Pot_wt(i));
        addpoints(h2_pv, t, Pot_pv(i));
        addpoints(h2_d, t, Pot_descarga);
        addpoints(h2_c, t, Pot_carga);
        addpoints(h2_demand, t, demand(i));
        ax2.XLim = [max(0, t - 50), t + 5];

        % Estado de Carga
        socBar.Position = [-0.4 0 0.8*SoC(i) 1]; % atualiza largura do preenchimento
        if SoC(i) > 0.6
            socBar.FaceColor = 'g';
        elseif SoC(i) > 0.3
            socBar.FaceColor = 'y';
        else
            socBar.FaceColor = 'r';
        end

        drawnow limitrate; % otimiza performance

    catch ME
        if ~isvalid(s)
            disp("A porta serial foi fechada. Encerrando.");
            break;
        end
    end

    % Controle simples do nível de água
    % if (nivelAgua(i)>=ref_h2)
    %     ucc = 1;
    %     uel = 0;
    % elseif (nivelAgua(i)<=ref_h2 - 0.5)
    %     ucc = 0;
    %     uel = 1;
    % end

    % --- Chamada do controlador PI para SoC ---
    % [Pot_carga, Pot_descarga, integrador] = controleSoC(SoC(end), SoC_ref, integrador, Kp, Ki, Ts, Pc_max, Pd_max)

    if i > time_to_turn_on
    %try
        %%%%%%%%%%%%%%%%%%
        %%%%%% MPC %%%%%%%
        %%%%%%%%%%%%%%%%%%
        
        % Fixed demand
        
    
        xref = [SoC_ref;ref_h2/10;demand(end)/1000];

        if isnan(nivelAgua(end))
            nivelAgua(end) = ref_h2;
        end
    
        x_prev = [SoC(end); nivelAgua(end)/10; Pot_total(end)/1000];
    
        d = [Pot_wt(end); Pot_pv(end)];
        %d = [0;0];

        mpc = update_mpc_Aeq(mpc, mpc.Aeq0, Bd0);
        % The function 'update_mpc_beq' can be replaced by
        % update_mpc_precomputed_beq
        mpc = update_mpc_precomputed_beq(mpc, x_prev, d, n_rho, ...
            mpc.beq0, mpc.beq_ff0);
    
        tic
        x0 = init_mpc_warm_start(mpc,x_prev,u_prev,d);
        [u_prev,J,x0] = mpc_solve(x0,x_prev,u_prev,xref,d,mpc,[],[],[]);
        toc
    
        if isnan(u_prev)
            disp("Solution is NaN!")
        else
            Pot_carga = u_prev(1) * 400;
            Pot_descarga = u_prev(2) * 400;

            dat_pot_carga(i) = Pot_carga;
            dat_pot_descarga(i) = Pot_descarga;
        
            if u_prev(3) > 0.5
                uel = 1;
            else
                uel = 0;
            end
        
            if u_prev(4) > 0.5
                ucc = 1;
            else
                ucc = 0;
            end
          %  uel
            %u_prev(3)
         %   ucc
            %u_prev(4)
          %  disp("Solution is good!!!")
        end
        
        
    
        %%%%%%%%%%%%%%%%%%
        %%%%%%%%%%%%%%%%%%
        %%%%%%%%%%%%%%%%%%
    %catch
     %   disp('Infeasible solution!');
    end
end
%%
disp("Salvando dados em dados_microrrede.mat...");
save('dados_microrrede_lixo.mat', ...
     'nivelAgua', 'SoC', ...
     'Pot_cc', 'Pot_el', 'Pot_total', 'Pot_wt', 'Pot_pv', ...
     'Pot_carga', 'Pot_descarga', 'demand', 'dat_pot_carga', 'dat_pot_descarga');
disp("Dados salvos com sucesso.");
%%
close all
dat = load('dados_microrrede_final.mat');

SoC_ref = 0.6;
ref_h2 = 5;
dat.Pot_total = dat.Pot_total(1:2400);
dat.demand = dat.demand(1:2400);
dat.Pot_wt = dat.Pot_wt(1:2400);
dat.Pot_pv = dat.Pot_pv(1:2400);
dat.nivelAgua = dat.nivelAgua(1:2400);
dat.SoC = dat.SoC(1:2400);
dat.dat_pot_carga = dat.dat_pot_carga(1:2400);
dat.dat_pot_descarga = dat.dat_pot_descarga(1:2400);
dat.Pot_el = dat.Pot_el(1:2400);
dat.Pot_cc = dat.Pot_cc(1:2400);

for i=2:length(dat.Pot_total)
    if dat.Pot_total(i) == 0
        dat.Pot_total(i) = dat.Pot_total(i-1);
    end
    if dat.demand(i) == 0
        dat.demand(i) = dat.demand(i-1);
    end
    if dat.Pot_wt(i) == 0 && i > 1
        dat.Pot_wt(i) = dat.Pot_wt(i-1);
    end
    if dat.Pot_pv(i) == 0
        dat.Pot_pv(i) = dat.Pot_pv(i-1);
    end
end

% tratando dados
dat.Pot_total = max(50, dat.Pot_total);

for j = 2:length(dat.Pot_wt)
    if dat.Pot_wt(j) < 50
        dat.Pot_wt(j) = dat.Pot_wt(j - 1);
    end
end

time = linspace(0,24,2400);

% figure
% subplot(5,1,1)
% plot(time,dat.Pot_total, 'LineWidth', 1.5)
% hold on
% plot(time,dat.demand, 'LineWidth', 1.5)
% plot(time,dat.Pot_wt, 'LineWidth', 2.0)
% 
% dat.Pot_pv = movmean(dat.Pot_pv, 100);
% 
% plot(time, dat.Pot_pv, 'LineWidth', 2.0)
% %plot(dat.Pot_carga, 'LineWidth', 2.0,'LineStyle','-', 'Color', 'g')
% %plot(dat.Pot_descarga, 'LineWidth', 2.0,'LineStyle','-', 'Color', 'y')
% %plot(dat.Pot_el, 'LineWidth', 2.0,'LineStyle','-', 'Color', 'c')
% %plot(dat.Pot_cc, 'LineWidth', 2.0,'LineStyle','-', 'Color', 'r')
% legend('P_{total}(k)', 'y_{demand}(k)', 'P_{wt}(k)', 'P_{pv}(k)', 'NumColumns', 2, 'FontSize', 12)
% ylabel('Power (W)', 'FontSize', 14)
% %xlabel('Time (h)', 'FontSize', 14)
% xlim([0,24])
% grid on
% 
% dat.nivelAgua = movmean(dat.nivelAgua,10);
% 
% subplot(5,1,2)
% plot(time,dat.nivelAgua, 'LineWidth', 2.0)
% hold on
% plot(time, ref_h2*ones(length(dat.nivelAgua)), 'LineWidth', 2.0, 'LineStyle','--', 'Color', 'r')
% legend('H_2', 'H_2_{ref}', 'FontSize', 12)
% ylabel('Level of H_2\newline(mm)', 'FontSize', 14)
% %xlabel('Time (h)')
% xlim([0,24])
% grid on
% 
% subplot(5,1,3)
% plot(time,dat.SoC, 'LineWidth', 2.0)
% hold on
% plot(time, SoC_ref*ones(length(dat.SoC)), 'LineWidth', 2.0, 'LineStyle','--', 'Color', 'r')
% legend('SoC(k)', 'SoC_{ref}(k)', 'FontSize', 12)
% ylabel('SoC (%)', 'FontSize', 14)
% %xlabel('Time (h)')
% xlim([0,24])
% grid on
% 
% subplot(5,1,4)
% plot(time,dat.dat_pot_carga, 'LineWidth', 2.0)
% hold on
% plot(time,dat.dat_pot_descarga, 'LineWidth', 2.0)
% legend('P_{charge}', 'P_{discharge}', 'FontSize', 12)
