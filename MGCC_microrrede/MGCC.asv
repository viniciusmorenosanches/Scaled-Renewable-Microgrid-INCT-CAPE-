% --- Script Avançado com Controle por Teclado em Tempo Real ---

% Limpeza inicial
clear; clc; close all;
if ~isempty(instrfind)
     fclose(instrfind);
     delete(instrfind);
end

% --- 1. Configuração da Comunicação Serial ---
port = "COM8"; % !!! MUDE AQUI para a sua porta COM !!!
baudRate = 9600;
s = serialport(port, baudRate);
configureTerminator(s, "LF"); % Define o terminador de linha
disp("Conectado ao Arduino na porta " + port);

% --- 2. Preparação da Figura e do Callback ---
fig = figure; % Cria a figura e guarda a referência
h = animatedline;
ax = gca;
ax.YGrid = 'on';
title('Nível da Água (CLIQUE AQUI e use as teclas L, D, A, F)');
xlabel('Tempo (s)');
ylabel('Nível (mm)');

% A MÁGICA ACONTECE AQUI:
% Associa a função 'keyPressCallback' ao evento de pressionar uma tecla nesta figura
%fig.WindowKeyPressFcn = @(src, event) keyPressCallback(src, event, s);

% --- 3. Loop de Leitura e Plotagem ---
disp("Iniciando a leitura... O gráfico deve estar em foco para enviar comandos.");
startTime = datetime('now');
i = 0;
while ishandle(fig) % Continua enquanto a figura estiver aberta
    try
        i = i + 1;
        data_str = readline(s);
        valores = split(data_str, ',');  % cell array de strings
        valores_num = str2double(valores);  % array de doubles
        nivelAgua(i) = valores_num(1);
        Pot_cc(i) = valores_num(2);
        disp(nivelAgua(i));
        disp(Pot_cc(i));

        Pot_carga = 10000;
        Pot_descarga = 0;

        % --- Envio a cada 1 segundo ---
        t_now = seconds(datetime('now') - startTime);
        if t_now - lastSendTime >= 1
            lastSendTime = t_now;
            Pot_carga = 10000;
            Pot_descarga = 0;
            linha = sprintf('%.1f,%.1f', Pot_carga, Pot_descarga);
            writeline(s, linha);
        end

        
        if nivelAgua(i) > 100
            nivelAgua(i) = nivelAgua(i-1);
        end

        t = seconds(datetime('now') - startTime);
        
        addpoints(h, t, nivelAgua(i));
        ax.XLim = [max(0, t - 50), t + 5];
        drawnow limitrate; % 'limitrate' otimiza a performance
        
    catch ME
        % Se o usuário fechar a janela, o loop é interrompido
        if ~isvalid(s)
            disp("A porta serial foi fechada. Encerrando.");
            break;
        end
    end
end

% --- 4. Limpeza ---
clear s;
disp("Comunicação serial encerrada.");


% --- Função de Callback (executada a cada tecla pressionada) ---
function keyPressCallback(~, event, serial_obj)
    % 'event.Key' contém a tecla que foi pressionada
    cmd = lower(event.Key);
    
    switch cmd
        case {'l', 'd', 'a', 'f'}
            % Se a tecla for um comando válido, envia para o Arduino
            write(serial_obj, upper(cmd), "char");
            fprintf('Comando "%s" enviado!\n', upper(cmd));
        otherwise
            % Ignora outras teclas
    end
end

function ControleNivel(nivel)
    if (nivel>=3)
    end
end